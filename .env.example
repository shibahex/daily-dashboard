# Settings for docker-compose.yml: copy this file to .env and fill it in.
# In Portainer, add the same names under the stack's "Environment variables" instead.

# Your time zone, so "today" starts at your midnight (a name from
# https://en.wikipedia.org/wiki/List_of_tz_database_time_zones).
TZ=America/New_York

# Optional: another port on this server (nginx then proxies to that one).
# DASHBOARD_PORT=1628

# Ubuntu 23.10 and later: the AI's tools need this. Ubuntu blocks user namespaces for containers
# without an AppArmor profile; its own "podman" profile is as open as "unconfined" but allows
# them. Leave it unset elsewhere: a host without that profile won't start the container.
# DASHBOARD_APPARMOR=podman
