# Optional local settings. Copy to site/.env (git-ignored) and uncomment what you need.
# The server reads it on start; real environment variables take precedence.

# A local checkout of the MyFitnessPal MCP. Without it, the released package (mfp-mcp) is used.
# MFP_MCP_DIR=~/src/myfitnesspal-mcp

# Browser the MCP uses to renew your MyFitnessPal login. Needed on NixOS, where Playwright's own
# browsers don't run; e.g. a Chromium from `nix build nixpkgs#playwright-driver.browsers`.
# MFP_BROWSER_PATH=/path/to/chrome

# API keys, if you use Codex or Gemini CLI with a key instead of signing in
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# AnkiConnect, if you changed its address or set an API key in its add-on config
# ANKI_CONNECT_URL=http://127.0.0.1:8765
# ANKI_CONNECT_API_KEY=
